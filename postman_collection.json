{
  "info": {
    "name": "ShipNow API (Módulo 1 & 2)",
    "description": "Colección oficial de ShipNow API para Backend III (Coderhouse).\nIncluye Users, Sessions, Products y el Módulo de Mocking y Logística (Mocks en memoria y Seed controlado).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Register (rol siempre user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Laura\",\n  \"last_name\": \"Gómez\",\n  \"email\": \"laura@shipnow.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "register"
              ]
            }
          }
        },
        {
          "name": "Register con role admin o driver (se ignora)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Eve\",\n  \"last_name\": \"Test\",\n  \"email\": \"eve@shipnow.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"laura@shipnow.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "login"
              ]
            }
          }
        },
        {
          "name": "Current",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/current",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "current"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users (admin)",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          }
        },
        {
          "name": "Usuario por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          }
        },
        {
          "name": "Filtrar por status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?status=available",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "available"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrar por precio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?minPrice=100&maxPrice=2000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "minPrice",
                  "value": "100"
                },
                {
                  "key": "maxPrice",
                  "value": "2000"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar por nombre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?search=caja",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "caja"
                }
              ]
            }
          }
        },
        {
          "name": "Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Crear producto (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Caja Cartón Mediana 40x30x30\",\n  \"description\": \"Caja reforzada para envíos\",\n  \"price\": 1450,\n  \"stock\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          }
        },
        {
          "name": "Actualizar producto (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1600,\n  \"stock\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Eliminar producto (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Mocks (Generación en memoria)",
      "item": [
        {
          "name": "Mock Users (qty=5)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mocks/users?qty=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mocks",
                "users"
              ],
              "query": [
                {
                  "key": "qty",
                  "value": "5"
                }
              ]
            },
            "description": "Genera 5 usuarios cliente simulados en memoria sin password."
          }
        },
        {
          "name": "Mock Drivers (qty=5)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mocks/drivers?qty=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mocks",
                "drivers"
              ],
              "query": [
                {
                  "key": "qty",
                  "value": "5"
                }
              ]
            },
            "description": "Genera 5 repartidores (DRIVER) simulados en memoria."
          }
        },
        {
          "name": "Mock Orders con related_users (qty=5)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mocks/orders?qty=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mocks",
                "orders"
              ],
              "query": [
                {
                  "key": "qty",
                  "value": "5"
                }
              ]
            },
            "description": "Genera 5 pedidos simulados y devuelve los usuarios relacionados."
          }
        },
        {
          "name": "Mock Deliveries con entidades relacionadas (qty=5)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mocks/deliveries?qty=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mocks",
                "deliveries"
              ],
              "query": [
                {
                  "key": "qty",
                  "value": "5"
                }
              ]
            },
            "description": "Genera 5 entregas simuladas y devuelve pedidos, clientes y repartidores relacionados."
          }
        }
      ]
    },
    {
      "name": "Mocks (Seed controlada - Admin)",
      "item": [
        {
          "name": "Seed Database (qty=5)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mocks/seed?qty=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mocks",
                "seed"
              ],
              "query": [
                {
                  "key": "qty",
                  "value": "5"
                }
              ]
            },
            "description": "Inserta de forma controlada en MongoDB 5 usuarios, 5 repartidores, 5 pedidos y 5 entregas. Requiere rol admin y no estar en production."
          }
        },
        {
          "name": "Seed Database vía body (qty=10)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qty\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/mocks/seed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mocks",
                "seed"
              ]
            },
            "description": "Variante enviando qty en el body JSON."
          }
        }
      ]
    }
  ]
}
