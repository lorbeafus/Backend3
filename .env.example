PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/shipnow_dev
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1h

# Solo para npm run seed:admin; completar localmente, nunca publicar credenciales.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Logs locales: rotación por tamaño, 5 archivos por destino (incluye el activo).
# LOG_DIR=./logs
LOG_MAX_SIZE=5242880
LOG_MAX_FILES=5
